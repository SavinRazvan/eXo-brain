# eXo-brain — local environment template
#
#   cp .env.template .env
#   # edit .env with your secrets; never commit .env
#
# What actually reads these:
#   - Platform: src/api/app.py (EXO_*)
#   - Default provider at startup: src/modules/platform_bootstrap/service.py (EXO_DEFAULT_PROVIDER_*)
#   - OpenAI adapter + tutorials: OPENAI_API_KEY (standard SDK env name)
#   - Extra providers: POST /providers (api_key_env_var points at any env name you choose)
#
# You do NOT need every block below — pick one provider profile for local API dev,
# and set OPENAI_API_KEY only if you run OpenAI-backed notebooks or the default OpenAI profile.

# ── Platform (typical local dev) ─────────────────────────────────────────────
EXO_ENV=development
EXO_DEFAULT_PROVIDER_ID=openai
EXO_DB_PATH=.exo_data/exo.db

# Optional: pin browser origins instead of dev wildcard CORS
# EXO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: local API auth (32+ chars when EXO_AUTH_JWKS_URL is unset)
# EXO_AUTH_JWT_SECRET=local-dev-only-change-before-any-shared-deploy

# ── Profile A — OpenAI (native) — default dev bootstrap ─────────────────────
# Required for: API turns with default provider, tutorials 02 / 05 (live) / 08 (live)
OPENAI_API_KEY=

# Defaults apply when EXO_ENV=development (override only if needed):
# EXO_DEFAULT_PROVIDER_ADAPTER_CLASS=exo_adapter_openai.runtime.OpenAIAgentsRuntimeAdapter
# EXO_DEFAULT_PROVIDER_API_TYPE=openai_native
# EXO_DEFAULT_PROVIDER_BASE_URL=https://api.openai.com
# EXO_DEFAULT_PROVIDER_MODEL=gpt-4o-mini
# EXO_DEFAULT_PROVIDER_API_KEY_ENV_VAR=OPENAI_API_KEY

# ── Profile B — OpenAI-compatible vendor (Groq example) ─────────────────────
# Use the same OpenAI adapter; point base_url + api_key env at the vendor.
# Uncomment and comment out Profile A OPENAI_API_KEY if Groq is your only provider.
#
# GROQ_API_KEY=gsk_your_key_here
# EXO_DEFAULT_PROVIDER_ID=groq
# EXO_DEFAULT_PROVIDER_ADAPTER_CLASS=exo_adapter_openai.runtime.OpenAIAgentsRuntimeAdapter
# EXO_DEFAULT_PROVIDER_API_TYPE=openai_compatible
# EXO_DEFAULT_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# EXO_DEFAULT_PROVIDER_MODEL=llama-3.3-70b-versatile
# EXO_DEFAULT_PROVIDER_API_KEY_ENV_VAR=GROQ_API_KEY
#
# Other compatible endpoints (same pattern — set BASE_URL + KEY env name):
#   Together:  https://api.together.xyz/v1          + TOGETHER_API_KEY
#   Mistral:   https://api.mistral.ai/v1            + MISTRAL_API_KEY
#   Ollama:    http://127.0.0.1:11434/v1            + OLLAMA_API_KEY (often unused; use a placeholder)

# ── Profile C — Azure OpenAI (compatible) ───────────────────────────────────
# AZURE_OPENAI_API_KEY=
# EXO_DEFAULT_PROVIDER_ID=azure-openai
# EXO_DEFAULT_PROVIDER_ADAPTER_CLASS=exo_adapter_openai.runtime.OpenAIAgentsRuntimeAdapter
# EXO_DEFAULT_PROVIDER_API_TYPE=openai_compatible
# EXO_DEFAULT_PROVIDER_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# EXO_DEFAULT_PROVIDER_MODEL=gpt-4o-mini
# EXO_DEFAULT_PROVIDER_API_KEY_ENV_VAR=AZURE_OPENAI_API_KEY

# ── Profile D — Echo adapter (no external API, smoke / CI-style) ─────────────
# EXO_DEFAULT_PROVIDER_ID=echo
# EXO_DEFAULT_PROVIDER_ADAPTER_CLASS=exo_adapter_echo.runtime.EchoRuntimeAdapter
# EXO_DEFAULT_PROVIDER_API_TYPE=openai_compatible
# EXO_DEFAULT_PROVIDER_BASE_URL=http://127.0.0.1:0
# EXO_DEFAULT_PROVIDER_MODEL=echo

# ── Optional: register more providers at runtime (no extra .env names required) ─
# curl -X POST http://127.0.0.1:8000/providers -H "Content-Type: application/json" \\
#   -d '{"provider_id":"groq-2","adapter_class_ref":"exo_adapter_openai.runtime.OpenAIAgentsRuntimeAdapter",
#        "api_type":"openai_compatible","base_url":"https://api.groq.com/openai/v1",
#        "api_key_env_var":"GROQ_API_KEY","model":"llama-3.3-70b-versatile"}'

# ── Optional observability ───────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=exo-brain
