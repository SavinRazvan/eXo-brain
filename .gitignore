__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# local working tree (PR artifacts, planning trackers, alignment audits)
.local/

# secrets — never commit
.env
*.env

# virtual environments
.exo_env/
.venv/
venv/
env/

# local runtime artifacts
.exo_data/

# coverage reports
.coverage/
.coverage
htmlcov/

# local Docker Compose overrides (see docker-compose.override.example.yml)
docker-compose.override.yml

# eXo diverse
_archive/*
_archive/
.tmp_tools/*
.tmp_tools
# Top-level eXo_adapters/ (legacy sibling-clone fallback path) — always ignored.
eXo_adapters/

# packages/eXo_adapters/ holds a local sibling clone of the (private) eXo_adapters repo.
# Only the vendored exo-brain-core-contracts subtree is tracked for public CI.
# Everything else under packages/eXo_adapters/ is ignored to prevent accidental publishing.
packages/eXo_adapters/*
!packages/eXo_adapters/packages/
packages/eXo_adapters/packages/*
!packages/eXo_adapters/packages/exo-brain-core-contracts/
packages/eXo_adapters/packages/exo-brain-core-contracts/src/*.egg-info/

# Local Cursor / agent IDE config — keep on disk only; never push to remote
.agents/
.cursor/

# Legacy local adapter clone (includes its own .agents/.cursor/.local)
packages/eXo_adapters_old/

# private research corpus (kept off-git by maintainer policy)
_research_results/
_research_results/*
